# Dedicated mainnet hot wallet only. Never put the private key itself in this file.
RPC_URL=https://your-mainnet-rpc.example.com
KEYPAIR_PATH=~/.config/solana/flash-bot.json
SOLANA_CLUSTER=mainnet-beta

# Kamino Main Market and its verified WSOL reserve. Re-run `npm run inspect:reserve`
# if you choose another market, then pin that reserve here.
KAMINO_LENDING_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF
KAMINO_WSOL_RESERVE=d4A2prbA2whesmvHaL88BH6Ewn5N4bTSU2Ze8P6Bc4Q

# Public whitelist for LST redemption: LST mint, SPL stake pool, and candidate sizes.
# Add only pools that you have independently verified.
STRATEGIES_FILE=./strategies.json

# Separate quote-only DEX-cycle allowlist. `scan:pairs` and `watch:pairs` never
# load the keypair, request instructions, build a transaction, simulate, sign, or send.
PAIR_STRATEGIES_FILE=./pair-strategies.json

# Jupiter Swap API. lite-api is rate limited; production needs a dedicated RPC/API key.
# Every call is bounded by JUPITER_TIMEOUT_MS and retried up to JUPITER_MAX_RETRIES
# times on transport errors, HTTP 429, and HTTP 5xx.
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=
JUPITER_TIMEOUT_MS=8000
JUPITER_MAX_RETRIES=2
ONLY_DIRECT_ROUTES=true
MAX_QUOTE_ACCOUNTS=40
# Capped at 500 bps; a larger value is rejected at load time.
SLIPPAGE_BPS=25
STRICT_JUPITER_VALIDATION=true

# Dynamic gate per candidate: final protected WSOL must cover repayment +
# MAX_TX_COST_SOL + MIN_NET_PROFIT_SOL. For LST this final output is WithdrawSol;
# for pair observation it is the protected output of Jupiter leg two.
# MAX_FLASH_FEE_BPS is checked relative to each borrow size, so amount scanning remains valid.
MAX_FLASH_FEE_BPS=1
MIN_NET_PROFIT_SOL=0.01
MAX_TX_COST_SOL=0.005
MIN_GAS_BALANCE_SOL=0.02

# On-chain WithdrawSol floor. With this enabled, the redemption carries a
# minimum-lamports-out floor (StakePoolInstruction::WithdrawSolWithSlippage,
# borsh variant 26, appended by the SPL Stake Pool program in Feb 2023), so a
# redemption shortfall reverts the atomic transaction instead of being silently
# covered from the wallet's own SOL during the repayment step. Only set this to
# false after verifying that the target cluster's stake-pool program rejects the
# variant; the failure shows up in `npm run simulate` and nothing is broadcast.
STAKE_POOL_WITHDRAW_SLIPPAGE=true

# Landing settings. Priority-fee risk is included in MAX_TX_COST_SOL.
# COMPUTE_UNIT_PRICE_MICROLAMPORTS must be at least 1.
COMPUTE_UNIT_LIMIT=1200000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=10000
POLL_MS=5000
# Pair observer performs serial public Jupiter quotes; keep this slower.
PAIR_POLL_MS=300000
# Local CSV + JSONL analytics output; the repository ignores these directories.
PAIR_OBSERVATION_LOG_DIR=./logs/pair-observations
# Finalized LST execution receipts, public balance snapshots, and program logs.
EXECUTION_AUDIT_LOG_DIR=./logs/execution-audits

# Both this setting and --yes are required before any send.
EXECUTION_ENABLED=false

# Armed-execution guardrails. Every broadcast passes through both limits, and
# tripping either one terminates `watch --execute` instead of looping past it:
#   MIN_SEND_INTERVAL_MS   minimum wall-clock gap between two broadcasts
#   MAX_SENDS_PER_SESSION  hard number of broadcasts allowed per process
MIN_SEND_INTERVAL_MS=10000
MAX_SENDS_PER_SESSION=5
