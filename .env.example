# Use a dedicated mainnet hot wallet with only fee/rent SOL. Do NOT put a private key in this file.
RPC_URL=https://your-mainnet-rpc.example.com
KEYPAIR_PATH=~/.config/solana/flash-bot.json
SOLANA_CLUSTER=mainnet-beta

# Required: choose the Kamino market containing the WSOL reserve and verify it yourself.
KAMINO_LENDING_MARKET=REPLACE_WITH_KAMINO_MARKET_ADDRESS
# Optional safety pin. If omitted, the bot locates WSOL by mint inside the configured market.
# KAMINO_WSOL_RESERVE=REPLACE_WITH_WSOL_RESERVE_ADDRESS

# Official mrgnFi LST SPL stake-pool defaults. The bot validates the on-chain mint.
STAKE_POOL_ADDRESS=DqhH94PjkZsjAqEze2BEkWhFQJ6EyU6MdtMphMgnXqeK
LST_MINT=LSTxxxnJzKDFSLr4dUkPcmCf5VyryEqzPLz5j4bpxFp

# Jupiter Swap API. lite-api works for development/rate-limited use; production should use an API key/RPC.
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=
ONLY_DIRECT_ROUTES=true
MAX_QUOTE_ACCOUNTS=40
SLIPPAGE_BPS=25
STRICT_JUPITER_VALIDATION=true

# Requested atomic flow. Amounts are exact decimal strings (9 decimals for SOL / LST).
FLASH_BORROW_SOL=2.5
MIN_LST_OUT=1.1133
LST_TO_BURN=1.1133
MIN_WITHDRAW_SOL=3.3119
# A 0.001% fee for 2.5 SOL is 0.000025 SOL. This is a ceiling, not a hard-coded repayment.
MAX_FLASH_FEE_SOL=0.00003
# Withdrawal must also cover repayment + this profit floor + worst-case network budget.
MIN_NET_PROFIT_SOL=0.01
MAX_TX_COST_SOL=0.005
MIN_GAS_BALANCE_SOL=0.02

# Landing settings. Treat the priority fee as a maximum cost input to your profit gate.
COMPUTE_UNIT_LIMIT=1200000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=10000
POLL_MS=5000

# Sending needs BOTH this switch and the --yes CLI flag. Keep false while testing.
EXECUTION_ENABLED=false
